# Copy to .env and fill in values (do not commit real secrets).

# ----------------------------
# Database (task manager)
# ----------------------------
# Preferred: full SQLAlchemy URL
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Or provide individual fields (DB_PASSWORD required for Postgres mode)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
# DB_PASSWORD=

# If no Postgres is configured, a local SQLite fallback will be used:
SQLITE_FALLBACK_URL=sqlite:////tmp/mcp_ic_tool_tasks.db

# ----------------------------
# VASP server paths / URLs
# ----------------------------
# Root directory for calculation outputs (used by /download and /static)
VASP_WORK_ROOT=/data/home/ysl9527/vasp_calculations

# Public base URL where users access this service (for generating download/static URLs)
VASP_PUBLIC_BASE_URL=https://api.matterai.tech

# API base URL used by the MCP client
VASP_SERVER_BASE_URL=https://api.matterai.tech
INTERNAL_WORKER_TOKEN=worker-token

# ----------------------------
# Object storage
# ----------------------------
ARTIFACT_STORAGE_BACKEND=oss
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
# S3_ENDPOINT=
OSS_BUCKET=vasp-artifacts
OSS_REGION=cn-hangzhou
OSS_ACCESS_KEY_ID=test-access-key
OSS_ACCESS_KEY_SECRET=test-secret
ARTIFACT_URL_EXPIRE_SECONDS=3600
LEGACY_LOCAL_ARTIFACT_URLS_ENABLED=false

# ----------------------------
# MCP server
# ----------------------------
MCP_HOST=0.0.0.0
MCP_PORT=8130
# MCP_BASE_URL=http://localhost:8130

# Default user id fallback (dev only; production should use auth/real user ids)
DEFAULT_USER_ID=123

# ----------------------------
# Remote runner (optional)
# ----------------------------
VASP_REMOTE_RUN_URL=http://localhost:8140
VASP_REMOTE_RUN_PORT=8140

# ----------------------------
# VASP toolchain paths
# ----------------------------
VASP_PATH=/data/app/vasp/6.3.2-intel/bin/vasp_std
PSEUDO_PATH=/data/home/ysl9527/software/psudopotential
U_VALUES_JSON=/data/home/ysl9527/software/u_values.json
BADER_PATH=/data/home/ysl9527/software/bader
CHGSUM_PL_PATH=/data/home/ysl9527/software/chgsum.pl

# ----------------------------
# SLURM submission (optional)
# ----------------------------
SLURM_NODES=2
SLURM_NTASKS=80
SLURM_TASKS_PER_NODE=40
SLURM_PARTITION=p1
SLURM_TIME_LIMIT=24:00:00
SLURM_MODULE_LOAD=vasp/6.3.2-intel
ONEAPI_ENV_SCRIPT=/data/app/intel/oneapi-2023.2/setvars.sh
VASP_SLURM_RUN_LINE=mpirun -np $SLURM_NPROCS vasp_std>result.log 2>&1
